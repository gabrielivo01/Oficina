{
  "uid": "oficina-overview-local",
  "title": "Oficina - Visao Geral (demo local)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Ordens de servico abertas (ultimas 24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(oficina_ordens_servico_abertas_total[24h]))",
          "legendFormat": "OS abertas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Healthcheck / uptime (oficina-app)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"oficina-app\"}",
          "legendFormat": "app",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Falhas de notificacao por canal",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(oficina_notificacoes_falhas_total[5m])) by (canal)",
          "legendFormat": "{{canal}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tempo medio no status (por status da OS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(oficina_ordens_servico_tempo_no_status_seconds_sum[5m])) by (status) / sum(rate(oficina_ordens_servico_tempo_no_status_seconds_count[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latencia das APIs (p95, por rota)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"oficina-app\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU do processo (oficina-app)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"oficina-app\"}",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Memoria heap da JVM (oficina-app)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"oficina-app\", area=\"heap\"})",
          "legendFormat": "heap usado",
          "refId": "A"
        }
      ]
    }
  ]
}
